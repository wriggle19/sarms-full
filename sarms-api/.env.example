# ============================================================
# SARMS API — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- Database ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL="postgresql://sarms:CHANGE_ME@localhost:5432/sarms"

# --- JWT ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be set. The application will refuse to start in production without this.
JWT_SECRET="CHANGE_ME_generate_a_64_byte_random_hex_string"

# --- Server ---
PORT=3000
NODE_ENV=development

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:5173

# --- Frontend URL (used in password-reset links) ---
FRONTEND_URL=http://localhost:5173

# --- File uploads ---
# Absolute path to the directory where uploaded attachments are stored.
# Must be writable by the API process. In Docker, mount a volume here.
UPLOAD_DIR=./uploads

# --- Email (optional — in-app notifications work without this) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=no-reply@school.org
# SMTP_PASS=CHANGE_ME
# SMTP_FROM=SARMS <no-reply@school.org>

# --- Development helpers (NEVER enable in production) ---
# Set to "true" to return the raw password-reset token in the API response
# (useful for testing without SMTP). Must be "false" or unset in production.
EXPOSE_RESET_TOKEN=false

# --- Rate limiting ---
# RATE_LIMIT_TTL_MS=60000
# RATE_LIMIT_MAX=200

# --- Scheduler (in-process recurring scans: overdue loans, warranty expiry) ---
# Set to "false" to disable (e.g. when an external cron hits the
# POST /scheduler/run-* endpoints, or in multi-replica deployments).
SCHEDULER_ENABLED=true
# Milliseconds between scans (default: 3600000 = 1 hour)
SCHEDULER_INTERVAL_MS=3600000

# --- Seeding (used by `npx ts-node prisma/seed.ts`) ---
# Password assigned to the seeded admin account. Change on first login.
SEED_ADMIN_PASSWORD=CHANGE_ME
# Required (and must be "true") to allow seeding when NODE_ENV=production.
# The seed script refuses to run against a production database otherwise.
# SEED_ALLOW_PRODUCTION=false
